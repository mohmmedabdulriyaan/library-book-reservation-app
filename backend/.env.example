# Copy this file to ".env" and change values if needed
MONGO_URI=mongodb://127.0.0.1:27017/library_app
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret

# ----- Emails (optional, sent with Brevo: brevo.com, free) -----
# Leave empty to turn emails off.
BREVO_API_KEY=
EMAIL_FROM="College Library <yourname@gmail.com>"
