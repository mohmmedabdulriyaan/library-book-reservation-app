# Copy this file to ".env" and change values if needed
MONGO_URI=mongodb://127.0.0.1:27017/library_app
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret

# ----- Email reminders (optional) -----
# Leave these empty to turn emails off. For Gmail use an "App password".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
